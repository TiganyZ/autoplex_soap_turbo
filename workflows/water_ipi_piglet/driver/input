! turboGAP as an i-PI force engine. `turbogap ipi` takes coordinates from the
! socket and returns energy, forces and virial; i-PI owns the beads, the PIGLET
! thermostat and the integrator.
!
! atoms_file is read ONCE, for the species, the masses and the cell -- i-PI
! overwrites the positions on its first POSDATA and the forces computed for
! this file are discarded. It must be the same system i-PI is running.
atoms_file = "init_tg.xyz"
pot_file = "gap_files/energy/energy.gap"
n_species = 2
species = H O
masses = 1.008 15.999
e0 = 0. 0.
soap_radial_legacy_filter = .false.
random_seed = 12345

ipi_address = 'UNIX:tgpiglet'

! The SAME energy model, with the SAME dispersion correction, as the classical
! and quantum-thermostat trajectories this run is to be compared against. The
! point of the arm is that only the nuclei change.
vdw_type = ts
vdw_rcut = 25.0
