# water\\_ir\\_matching\\_trial: equilibration drift
#
# Generated by ir_analysis.py for this run: the arm names, colours and column
# numbers below match equilibration.dat. Regenerating the run regenerates this script.
#
#   gnuplot equilibration.gp          -> equilibration.png
#
# For a vector version, replace the terminal line with
#   set terminal pdfcairo enhanced font "Helvetica,11" size 9in,5.5in
# and give the output a .pdf name.

set terminal pngcairo enhanced font "Helvetica,12" size 1400,900
set output "equilibration.png"
set encoding utf8
set border 3 lw 1.2 lc rgb "#444444"
set tics nomirror out
set key outside right top spacing 1.2 samplen 2
set grid ytics lc rgb "#dddddd" lw 1


# One panel per observable. The test is that consecutive windows
# AGREE, not that any of them equals a particular value: the
# hydrogen-bond network keeps relaxing long after the temperature
# has settled, which is why temperature is not the test.
set multiplot layout 3,1 title "water\\_ir\\_matching\\_trial: is it equilibrated?"
set key off
set xtics 1

unset xlabel
set ylabel "E\\_kin"
plot "equilibration.dat" u 1:2 w lp pt 7 ps 1.4 lc rgb "#1e5f9e" lw 2 notitle

unset xlabel
set ylabel "S\\_total"
plot "equilibration.dat" u 1:3 w lp pt 7 ps 1.4 lc rgb "#1e5f9e" lw 2 notitle

set xlabel "DoSPT window"
set ylabel "f\\_CM"
plot "equilibration.dat" u 1:4 w lp pt 7 ps 1.4 lc rgb "#1e5f9e" lw 2 notitle

unset multiplot
