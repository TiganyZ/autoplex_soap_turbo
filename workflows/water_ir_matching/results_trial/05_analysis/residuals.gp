# water\\_ir\\_matching\\_trial: residuals.gp
#
# Generated by ir_analysis.py for this run: the arm names, colours and column
# numbers below match residuals.dat. Regenerating the run regenerates this script.
#
#   gnuplot residuals.gp          -> ir_residuals.png
#
# For a vector version, replace the terminal line with
#   set terminal pdfcairo enhanced font "Helvetica,11" size 9in,5.5in
# and give the output a .pdf name.

set terminal pngcairo enhanced font "Helvetica,12" size 1400,900
set output "ir_residuals.png"
set encoding utf8
set border 3 lw 1.2 lc rgb "#444444"
set tics nomirror out
set key outside right top spacing 1.2 samplen 2
set grid ytics lc rgb "#dddddd" lw 1


set style line 1 lc rgb "#1e5f9e" lw 1.4 dt 2
set style line 2 lc rgb "#1e5f9e" lw 2.2 dt 1
set style line 3 lc rgb "#b4471b" lw 1.4 dt 2
set style line 4 lc rgb "#b4471b" lw 2.2 dt 1
set style line 5 lc rgb "#2f7a52" lw 1.4 dt 2
set style line 6 lc rgb "#2f7a52" lw 2.2 dt 1

set xlabel "wavenumber  (cm^{-1})"
set ylabel "sqrt(w) ( I_{pred} - I_{exp} )"
set title "what the dissimilarity sums\npositive is too much absorption, negative too little"
set xrange [420:3993]
set arrow from graph 0,first 0 to graph 1,first 0 nohead lc rgb "#888888" lw 1 dt 3

plot "residuals.dat" u 1:2 w l ls 1 t "ref\\_naive", \
     "residuals.dat" u 1:3 w l ls 2 t "biased\\_naive", \
     "residuals.dat" u 1:4 w l ls 3 t "ref\\_xl", \
     "residuals.dat" u 1:5 w l ls 4 t "biased\\_xl", \
     "residuals.dat" u 1:6 w l ls 5 t "ref\\_gle", \
     "residuals.dat" u 1:7 w l ls 6 t "biased\\_gle"
