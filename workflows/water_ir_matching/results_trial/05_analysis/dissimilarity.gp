# water\\_ir\\_matching\\_trial: dissimilarity.gp
#
# Generated by ir_analysis.py for this run: the arm names, colours and column
# numbers below match trace_*.dat. Regenerating the run regenerates this script.
#
#   gnuplot dissimilarity.gp          -> ir_dissimilarity.png
#
# For a vector version, replace the terminal line with
#   set terminal pdfcairo enhanced font "Helvetica,11" size 9in,5.5in
# and give the output a .pdf name.

set terminal pngcairo enhanced font "Helvetica,12" size 1400,900
set output "ir_dissimilarity.png"
set encoding utf8
set border 3 lw 1.2 lc rgb "#444444"
set tics nomirror out
set key outside right top spacing 1.2 samplen 2
set grid ytics lc rgb "#dddddd" lw 1


set style line 1 lc rgb "#1e5f9e" lw 1.4 dt 2
set style line 2 lc rgb "#1e5f9e" lw 2.2 dt 1
set style line 3 lc rgb "#b4471b" lw 1.4 dt 2
set style line 4 lc rgb "#b4471b" lw 2.2 dt 1
set style line 5 lc rgb "#2f7a52" lw 1.4 dt 2
set style line 6 lc rgb "#2f7a52" lw 2.2 dt 1

set xlabel "MD step"
set ylabel "live dissimilarity"
set title "the quantity the bias minimises, while it was on\nzero -- and so not plotted -- until the estimator's buffer filled"

plot "trace_ref_naive.dat" u 1:($3 > 0 ? $3 : 1/0) w l ls 1 t "ref\\_naive", \
     "trace_biased_naive.dat" u 1:($3 > 0 ? $3 : 1/0) w l ls 2 t "biased\\_naive", \
     "trace_ref_xl.dat" u 1:($3 > 0 ? $3 : 1/0) w l ls 3 t "ref\\_xl", \
     "trace_biased_xl.dat" u 1:($3 > 0 ? $3 : 1/0) w l ls 4 t "biased\\_xl", \
     "trace_ref_gle.dat" u 1:($3 > 0 ? $3 : 1/0) w l ls 5 t "ref\\_gle", \
     "trace_biased_gle.dat" u 1:($3 > 0 ? $3 : 1/0) w l ls 6 t "biased\\_gle"
