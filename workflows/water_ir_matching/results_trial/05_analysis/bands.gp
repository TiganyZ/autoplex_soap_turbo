# water\\_ir\\_matching\\_trial: bands.gp
#
# Generated by ir_analysis.py for this run: the arm names, colours and column
# numbers below match bands.dat. Regenerating the run regenerates this script.
#
#   gnuplot bands.gp          -> ir_bands.png
#
# For a vector version, replace the terminal line with
#   set terminal pdfcairo enhanced font "Helvetica,11" size 9in,5.5in
# and give the output a .pdf name.

set terminal pngcairo enhanced font "Helvetica,12" size 1400,900
set output "ir_bands.png"
set encoding utf8
set border 3 lw 1.2 lc rgb "#444444"
set tics nomirror out
set key outside right top spacing 1.2 samplen 2
set grid ytics lc rgb "#dddddd" lw 1


set style data histogram
set style histogram clustered gap 1
set style fill solid 0.85 border lt -1
set boxwidth 0.9
set xtics rotate by -20
set ylabel "fraction of the arm's dissimilarity"
set title "where the mismatch lives\na bias can only help where there is something to fix"
set yrange [0:*]

plot "bands.dat" u 3:xtic(2) lc rgb "#1e5f9e" fs solid 0.35 t "ref\\_naive", \
     "bands.dat" u 4:xtic(2) lc rgb "#1e5f9e" fs solid 0.9 t "biased\\_naive", \
     "bands.dat" u 5:xtic(2) lc rgb "#b4471b" fs solid 0.35 t "ref\\_xl", \
     "bands.dat" u 6:xtic(2) lc rgb "#b4471b" fs solid 0.9 t "biased\\_xl", \
     "bands.dat" u 7:xtic(2) lc rgb "#2f7a52" fs solid 0.35 t "ref\\_gle", \
     "bands.dat" u 8:xtic(2) lc rgb "#2f7a52" fs solid 0.9 t "biased\\_gle"
